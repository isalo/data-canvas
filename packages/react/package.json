{
  "name": "@data-canvas/react",
  "version": "0.1.0",
  "description": "EntityScreen, EntityGrid, EntityForm and EntityLookup components for DataCanvas.",
  "license": "MIT",
  "author": "isalo",
  "repository": {
    "type": "git",
    "url": "https://github.com/isalo/data-canvas",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@data-canvas/core": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.20.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
