{
  "name": "@datacanvas/adapter-drizzle",
  "version": "0.1.0",
  "description": "Drizzle ORM / PostgreSQL adapter for DataCanvas.",
  "license": "MIT",
  "author": "isalo",
  "repository": {
    "type": "git",
    "url": "https://github.com/isalo/data-canvas",
    "directory": "packages/adapters/drizzle"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@datacanvas/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.38.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
